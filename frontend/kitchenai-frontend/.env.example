# Google OAuth Client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend API URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Android Expo push (native builds only): download google-services.json from Firebase
# (package com.kitchenai.app) and save as frontend/kitchenai-frontend/google-services.json
# Then rebuild: npm run android. Also upload FCM V1 service account to expo.dev credentials.

# Hidden web ops panel path segment (default: kitchen-ops → https://yoursite.com/kitchen-ops).
# EXPO_PUBLIC_ADMIN_PATH=kitchen-ops

# Dish photos CDN root (WebP). Usually same as backend DISH_IMAGES_CDN_URL from /app/config.
# Upload to R2: npm run sync:dishes:r2 (see r2.env.example)
# EXPO_PUBLIC_DISH_IMAGES_CDN_URL=https://pub-xxxx.r2.dev

# Bill scan (photos/PDF) is handled by the backend (Google Vision OCR + Groq). No client OCR env vars.

# Optional: Google account that always sees onboarding (default: infinitystones464@gmail.com)
# EXPO_PUBLIC_ONBOARDING_PREVIEW_EMAIL=infinitystones464@gmail.com
