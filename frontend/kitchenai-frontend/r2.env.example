# Cloudflare R2 — dish image CDN upload (copy to r2.env, never commit r2.env)
#
# 1. Cloudflare dashboard → R2 → Create bucket (e.g. rasoibuddy-dishes)
# 2. Bucket → Settings → Public access → Allow Access / connect custom domain
#    Copy the public URL (https://pub-xxxx.r2.dev or https://cdn.yourdomain.com)
# 3. R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# 4. Account ID: Cloudflare dashboard → right sidebar on any page
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rasoibuddy-dishes
# Public CDN root (no trailing slash). Same value as backend DISH_IMAGES_CDN_URL.
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
